# Copy outside the repository or inject these values from a secret manager.
# Never commit the populated file.
# Shipped Android builds use this exact canonical origin.
PUBLIC_DOMAIN=api.jarvis.ai
ACME_EMAIL=security@example.com
# Single-instance decision: must remain 1 until shared circuit/metrics state is implemented.
APPLICATION_REPLICA_COUNT=1

DATABASE_USER=jarvis
DATABASE_PASSWORD=replace-with-secret-manager-value
LICENSE_CODE_PEPPER=replace-with-at-least-64-random-characters-before-production
BILLING_PLANS=earclip-monthly|jarvis-earclip|JARVIS Earclip Monthly|30|1400|USD|pri_replace_me|USDT

# Format: token:clientId. Generate token with: openssl rand -hex 32
JARVIS_CLIENT_TOKENS=replace-with-64-char-token:operations
JARVIS_ADMIN_CLIENTS=operations

# Control Plane (web-админка /v1/admin/ui). Bootstrap создаёт SUPER_ADMIN ОДИН раз,
# только если таблица admin_accounts пуста. Пароль >= 12 символов, потом смените.
JARVIS_ADMIN_BOOTSTRAP_USERNAME=admin
JARVIS_ADMIN_BOOTSTRAP_PASSWORD=replace-with-12+-char-password

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_HOSTS=

HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_WEBHOOK_IPS=31.133.220.8
HELEKET_ENFORCE_WEBHOOK_IP=true

GROQ_ENABLED=true
GROQ_API_KEY=
GEMINI_ENABLED=true
GEMINI_API_KEY=
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
