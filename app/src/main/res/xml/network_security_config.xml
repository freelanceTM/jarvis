<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Запрет небезопасного HTTP трафика по умолчанию в production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Не доверяем пользовательским CA в production: иначе
                 установленный на устройстве CA может перехватить Bearer-токен. -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Разрешение cleartext для localhost и эмулятора (Android Debug / Local testing) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
