<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Staging/prod: no cleartext and no user-installed CA trust. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
