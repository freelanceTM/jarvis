# ============================================================================
# JARVIS API — пример конфигурации (Этап 3)
#
# СКОПИРУЙТЕ в server/.env и подставьте реальные значения.
# .env добавлен в .gitignore и НИКОГДА не должен попадать в репозиторий.
# ============================================================================

# Development defaults: HTTP is loopback-only. Production must use the
# deploy/Caddyfile topology and the explicit safety flags below.
APP_ENV=development
BIND_HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=
PRODUCTION_TLS_TERMINATED=false
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# PRODUCTION (example; do not enable without a real TLS terminator):
# APP_ENV=production
# BIND_HOST=0.0.0.0
# PUBLIC_BASE_URL=https://api.example.com
# PRODUCTION_TLS_TERMINATED=true
# TRUST_PROXY_HEADERS=true
# TRUSTED_PROXY_CIDRS=172.30.0.2/32

# --- Клиентские токены: "token:clientId,token2:clientId2" --------------------
# Генерация: openssl rand -hex 32
JARVIS_CLIENT_TOKENS=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef:android-client-1

# Статические токены предназначены для ADMIN/операционных клиентов.
# Android после atomic redeem получает отдельный DB-backed jrv_ token.
JARVIS_ADMIN_CLIENTS=android-client-1

# --- PostgreSQL: обязательный source of truth лицензий и billing ------------
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/jarvis
DATABASE_USER=jarvis
DATABASE_PASSWORD=replace-with-secret-manager-value
DATABASE_POOL_SIZE=8
DATABASE_CONNECTION_TIMEOUT_MS=5000

# HMAC pepper: не менее 32 случайных байт; хранить в Secret Manager.
# Ротация требует отдельной процедуры, иначе старые code/token hashes перестанут находиться.
LICENSE_CODE_PEPPER=replace-with-at-least-64-random-characters-before-production

# id|product|displayName|durationDays|amountMinor|currency|paddlePriceId|heleketTargetCurrency
# Несколько планов разделяются точкой с запятой; '-' отключает provider для плана.
BILLING_PLANS=earclip-monthly|jarvis-earclip|JARVIS Earclip Monthly|30|1400|USD|pri_replace_me|USDT

LICENSE_REDEEM_PER_MINUTE=5
LICENSE_REDEEM_PER_DAY=30
LICENSE_AUTH_PER_MINUTE=30
LICENSE_AUTH_PER_DAY=1000
BILLING_WEBHOOK_PER_MINUTE=120
BILLING_WEBHOOK_PER_DAY=20000

# --- Paddle Billing (international checkout; sandbox until live approval) ----
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_REQUEST_TIMEOUT_MS=15000
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# Add your approved Paddle default-payment-link/custom checkout host if used.
PADDLE_CHECKOUT_HOSTS=

# --- HELEKET crypto invoices -------------------------------------------------
# PUBLIC_BASE_URL above is also used to construct the signed callback URL.
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_REQUEST_TIMEOUT_MS=15000
HELEKET_INVOICE_LIFETIME_SECONDS=3600
HELEKET_WEBHOOK_IPS=31.133.220.8
HELEKET_ENFORCE_WEBHOOK_IP=true
BILLING_RETURN_URL=https://example.com/billing/return
BILLING_SUCCESS_URL=https://example.com/billing/success

# Turkmenistan phone/mobile billing remains disabled until a merchant contract
# provides the bank/telecom API, callback signature scheme and production credentials.

# --- Ключи AI-провайдеров: ТОЛЬКО здесь, никогда в Android ------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Провайдеры: приоритет (меньше = раньше) и модели -----------------------
GROQ_ENABLED=true
GROQ_PRIORITY=1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CONNECT_TIMEOUT_MS=3000
GROQ_REQUEST_TIMEOUT_MS=15000

GEMINI_ENABLED=true
GEMINI_PRIORITY=2
GEMINI_MODEL=gemini-1.5-flash
GEMINI_CONNECT_TIMEOUT_MS=3000
GEMINI_REQUEST_TIMEOUT_MS=20000

OPENROUTER_ENABLED=true
OPENROUTER_PRIORITY=3
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_CONNECT_TIMEOUT_MS=3000
OPENROUTER_REQUEST_TIMEOUT_MS=25000

# --- Rate limiting (на клиента) ---------------------------------------------
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500

# --- Fallback / retry --------------------------------------------------------
MAX_PROVIDER_ATTEMPTS=3
MAX_RETRIES_PER_PROVIDER=1
RETRY_BACKOFF_MS=250

# --- Circuit breaker ---------------------------------------------------------
CB_FAILURE_THRESHOLD=3
CB_OPEN_COOLDOWN_MS=60000
CB_HALF_OPEN_SUCCESSES=1

# --- Валидация входа ---------------------------------------------------------
MAX_TEXT_LENGTH=8000
MAX_BODY_BYTES=32768

# --- Privacy policy ----------------------------------------------------------
# По умолчанию в облако выпускается только NORMAL.
ALLOW_PRIVATE_CLOUD=false
ALLOW_SENSITIVE_CLOUD=false

# --- Генерация ---------------------------------------------------------------
AI_MAX_TOKENS=512
AI_TEMPERATURE=0.6
